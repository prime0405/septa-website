# ---------------------------------------------------------------------------
# Septa — environment template
#
# Copy to `.env` and fill in what you actually have. Nothing here is required
# to boot: with an empty file the site runs, the API records submissions to
# SQLite, and every form says so honestly instead of pretending to send email.
#
# NEVER commit the filled-in `.env`. Server variables are read only by the
# Express API — the only variables that reach the browser are the VITE_* ones,
# and no secret belongs in that list.
# ---------------------------------------------------------------------------

# --- Frontend (safe to expose; inlined into the build) ---------------------
# Absolute origin used for canonical URLs and Open Graph tags, e.g.
# https://septa.example. Leave unset in development and the site omits them.
VITE_SITE_URL=

# Origin + path where the API is reachable FROM THE BROWSER.
# Leave unset for the normal setups: `npm run dev` proxies /api locally, and a
# deployed site can rewrite /api/* to the backend (see README → "Deploying to
# Vercel"), which keeps the calls same-origin and needs no CORS entry.
# Set it only when the API is on a different origin, e.g.
# VITE_API_BASE_URL=https://septa-api.onrender.com/api
# That origin must then appear in ALLOWED_ORIGINS below.
VITE_API_BASE_URL=

# Set to "true" to keep the developer "before launch" notes visible in a
# production build. Off by default; always on while running `npm run dev`.
# Useful while the deploy is frontend-only: the forms then state plainly that no
# backend is reachable instead of failing silently. Unset it once the API is live —
# the notes name internal files and the storage endpoint, which visitors do not need.
VITE_SHOW_LAUNCH_NOTES=

# Where `npm run dev` proxies /api requests. Change only if the API listens
# somewhere other than 127.0.0.1:8787.
# API_PROXY_TARGET=http://127.0.0.1:8787

# --- API server ------------------------------------------------------------
# Bind address. 127.0.0.1 keeps it local; use 0.0.0.0 behind a reverse proxy.
HOST=127.0.0.1
PORT=8787

# development | production
NODE_ENV=development

# Enable only when running behind a proxy that sets X-Forwarded-For, otherwise
# every request looks like it came from the proxy and rate limiting collapses
# into a single bucket. Accepts true / false / a hop count. Vercel is such a proxy,
# so a production deploy on Vercel sets this to true.
TRUST_PROXY=false

# Comma-separated list of browser origins allowed to call /api. Needed only when the
# browser calls the API on another origin (VITE_API_BASE_URL above). A same-origin
# deploy — frontend and /api in one Vercel project — needs no entry here.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Storage ---------------------------------------------------------------
# Submissions use whichever store is configured — same tables, same rows:
#   * no connection string -> SQLite under DATA_DIR (local development)
#   * a connection string  -> Postgres (required on Vercel, which has no disk)
# DATA_DIR / UPLOAD_DIR are still used locally for the database and CV files.
DATA_DIR=data
# DB_PATH=data/submissions.db
# UPLOAD_DIR=data/uploads

# Postgres connection string. On Vercel this is injected by the Prisma Postgres
# integration as POSTGRES_URL / DATABASE_URL / PRISMA_DATABASE_URL; locally, paste
# one into .env to test against the same database. A direct (non-pooled) host is
# switched to the pooled endpoint automatically, because short-lived requests opening
# one connection each exhaust a free plan's limit. The URL contains the password:
# never commit it, and rotate it if it ever reaches a terminal or a log.
# POSTGRES_URL=postgres://user:pass@pooled.db.prisma.io:5432/dbname
# DATABASE_URL=
# POSTGRES_POOL_URL=

# CV uploads: private Vercel Blob objects when a store is reachable, otherwise files
# under UPLOAD_DIR. On Vercel the Blob integration supplies BLOB_STORE_ID and the
# function authenticates with its own OIDC token — no token needed in your settings.
# Outside Vercel a read/write token is the only way to reach Blob; leave it unset to
# keep uploads on disk. A CV is never served over HTTP: the site stores a reference,
# and an anonymous GET of a Blob URL is refused.
# BLOB_STORE_ID=store_xxxxxxxx
# BLOB_READ_WRITE_TOKEN=

# --- Spam protection -------------------------------------------------------
RATE_LIMIT_ENABLED=true
# Submissions per window, per path, per IP address.
RATE_LIMIT_MAX=8
RATE_LIMIT_WINDOW_MS=60000
# Windows are counted in process memory. On a serverless platform every warm instance
# keeps its own count, so this stops one visitor hammering the form — it is not a
# distributed limit. Put a real defence (Turnstile, hCaptcha, the host's WAF) in front
# of the endpoints if the site starts drawing automated traffic.

# --- Email delivery --------------------------------------------------------
# Without ALL of the below the API stores submissions and reports
# `mode: "record-only"` — the UI then says plainly that nothing was emailed.
#
# Option A: a single provider URL (SendGrid, Mailgun, SES, Postmark, Zoho…):
# SMTP_URL=smtps://user:pass@smtp.example.com:465
#
# Option B: separate parts:
SMTP_HOST=
SMTP_PORT=
# true for port 465 (implicit TLS), false for 587 (STARTTLS).
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Address mail appears to come FROM — must be a domain you have verified.
SMTP_FROM=
# Optional: where replies should go. Defaults to INBOX_EMAIL.
SMTP_REPLY_TO=
# The address that actually receives enquiries. Required for delivery.
INBOX_EMAIL=

# How long to wait for SMTP before failing the request as "stored, not sent".
NOTIFY_TIMEOUT_MS=10000

# --- Career uploads --------------------------------------------------------
# May only tighten the limits declared in src/shared/schemas.ts. The default CV size
# (4 MB) sits under the ~4.5 MB body limit a Vercel Function refuses before the API
# sees the request; raising the environment value above the schema default does nothing.
# CV_MAX_BYTES=4194304
# CV_ALLOWED_EXT=pdf,doc,docx,rtf,txt
