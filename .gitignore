# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
/dist
/dist-ssr
*.local

# The Vercel Function entry is generated by `npm run build:api` on every build and is committed
# on purpose: a Git-triggered deploy scans the cloned source for functions before the build runs,
# so a bundle that only exists after `npm run build` produces no `/api` routes at all.

# Local environment — SMTP and inbox credentials live here, never in the bundle
.env
.env.*
!.env.example

# Submission store: real visitor data and uploaded CVs (created on first API boot).
# Anchored to the repo root on purpose — `data/` alone also matched src/data/,
# which is the site's content and must stay tracked.
/data/
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Vercel CLI link state (project id + org id, written by `vercel link`)
.vercel

# Skill files installed by agent tooling, not part of the website source
/.agents
/skills-lock.json
